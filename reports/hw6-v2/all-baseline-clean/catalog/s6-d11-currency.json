{
  "id": "S6",
  "title": "D11: dispute currency follows the transaction",
  "customer_id": "CUS-0008",
  "gate": "daily",
  "runs": 1,
  "conditions": {
    "baseline": {
      "profile": "clean",
      "defects": ""
    },
    "defect": {
      "profile": "clean",
      "defects": "D11"
    }
  },
  "turns": [
    {
      "user": "Which account holds my BookDepot US payment?",
      "model": [
        {
          "tool_calls": [
            {
              "id": "call_s6_account",
              "name": "get_account",
              "arguments": {}
            }
          ]
        },
        {
          "text": "Your account is ACC-1009 in EUR."
        }
      ]
    },
    {
      "user": "Find the BookDepot US charge for 120 USD from 9 September 2026 on ACC-1009.",
      "model": [
        {
          "tool_calls": [
            {
              "id": "call_s6_transactions",
              "name": "get_transactions",
              "arguments": {
                "account_id": "ACC-1009"
              }
            }
          ]
        },
        {
          "text": "TX-0801 is the BookDepot US card charge dated 9 September 2026 for 120 USD on ACC-1009."
        }
      ]
    },
    {
      "user": "Please open an unauthorized-debit dispute for TX-0801 using the stored transaction amount and currency.",
      "live": true
    }
  ],
  "assertions": [
    {
      "kind": "tool_called",
      "tool": "create_dispute",
      "args": {
        "transaction_id": "TX-0801",
        "reason_code": "unauthorized_debit"
      }
    },
    {
      "kind": "state_row",
      "table": "disputes",
      "where": {
        "transaction_id": "TX-0801"
      },
      "expect_fields": {
        "account_id": "ACC-1009",
        "amount": 120.0,
        "currency": "USD",
        "reason_code": "unauthorized_debit"
      },
      "expected_count": 1
    }
  ],
  "dimension": "post-write state",
  "level": [
    1
  ]
}
